# Copy to hybrid-rag/.env. Only OPENAI_API_KEY is required; every other value has a default.
# Never commit .env.
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_FAST_MODEL=gpt-5.4-nano
# OPENAI_REASONING_EFFORT=low
# OPENAI_FAST_REASONING_EFFORT=none
OPENAI_EMBED_MODEL=text-embedding-3-small
WEAVIATE_URL=http://localhost:8082
WEAVIATE_GRPC_PORT=50053
WEAVIATE_API_KEY=
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_MAX_FACTS=12
HYBRID_ALPHA=0.5
TOP_K=5
MAX_VECTOR_DISTANCE=0.75
PROMPT_VERSION=v1
