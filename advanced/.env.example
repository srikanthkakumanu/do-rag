# Copy to advanced/.env and fill in. Never commit .env. Empty values fall back to defaults.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_FAST_MODEL=gpt-5.4-nano
OPENAI_FAST_REASONING_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-small
WEAVIATE_URL=http://localhost:8081
WEAVIATE_GRPC_PORT=50052
WEAVIATE_API_KEY=
HYBRID_ALPHA=0.5
PER_QUERY_LIMIT=8
MULTI_QUERY_MAX=3
RERANK_CANDIDATES=8
RERANK_TOP_N=4
MIN_RERANK_SCORE=2
MAX_VECTOR_DISTANCE=0.75
PROMPT_VERSION=v1
